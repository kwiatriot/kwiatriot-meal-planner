# Supabase — get these from your project dashboard at supabase.com
# Settings → API Keys → New API Keys (publishable + secret)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key   # sb_publishable_…
SUPABASE_SECRET_KEY=your_supabase_secret_key                          # sb_secret_…

# Anthropic API — used server-side only for AI ingredient categorization on the shopping list.
# Get your key at console.anthropic.com. Must also be added to Vercel project settings
# (Settings → Environment Variables) for both Production and Preview environments.
ANTHROPIC_API_KEY=sk-ant-...

# Set to "true" to show the sign-up form (for local/testing only).
# Leave unset (or any other value) to disable public sign-up in production.
# NEXT_PUBLIC_ALLOW_SIGNUP=true
